{
  "name": "openclaw-tensorfold",
  "version": "0.2.0",
  "description": "OpenClaw provider plugin for TensorFold: OpenClaw starts tensorfold serve on demand, or connects to a running server",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "tensorfold",
    "local-llm",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashhart/openclaw-tensorfold.git"
  },
  "homepage": "https://github.com/ashhart/openclaw-tensorfold#readme",
  "files": [
    "dist/*.js",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openclaw": "2026.11.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "providers": [
      "tensorfold"
    ],
    "compat": {
      "pluginApi": ">=2026.11.3",
      "minGatewayVersion": "2026.11.3"
    },
    "build": {
      "openclawVersion": "2026.11.3",
      "pluginSdkVersion": "2026.11.3"
    }
  }
}
