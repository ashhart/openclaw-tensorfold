{
  "id": "tensorfold",
  "name": "TensorFold",
  "description": "TensorFold as a model provider: OpenClaw can start tensorfold serve on demand, or connect to a running server",
  "categories": [
    "models"
  ],
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": [
    "tensorfold"
  ],
  "modelCatalog": {
    "discovery": {
      "tensorfold": "refreshable"
    }
  },
  "providerRequest": {
    "providers": {
      "tensorfold": {
        "family": "tensorfold",
        "openAICompletions": {
          "supportsStreamingUsage": true
        }
      }
    }
  },
  "modelPricing": {
    "providers": {
      "tensorfold": {
        "external": false
      }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "tensorfold",
        "envVars": [
          "TENSORFOLD_API_KEY"
        ],
        "authMethods": [
          "local",
          "api-key"
        ]
      }
    ]
  },
  "providerAuthChoices": [
    {
      "provider": "tensorfold",
      "method": "local",
      "choiceId": "tensorfold-local",
      "choiceLabel": "TensorFold on this computer",
      "choiceHint": "OpenClaw starts tensorfold serve when a request needs it",
      "groupId": "tensorfold",
      "groupLabel": "TensorFold",
      "groupHint": "Local TensorFold inference",
      "appGuidedDiscovery": true,
      "appGuidedActionLabel": "Start TensorFold on this computer"
    },
    {
      "provider": "tensorfold",
      "method": "api-key",
      "choiceId": "tensorfold-api-key",
      "choiceLabel": "TensorFold server already running",
      "choiceHint": "Connect to a tensorfold serve you start yourself",
      "groupId": "tensorfold",
      "groupLabel": "TensorFold",
      "groupHint": "Local or self-hosted TensorFold server"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
